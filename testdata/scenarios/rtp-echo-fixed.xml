<?xml version="1.0" encoding="UTF-8"?>
<!--
This scenario acts as a User Agent Server (UAS) that handles
incoming INVITE requests and also responds to any other non-INVITE
SIP messages (like OPTIONS) with a 200 OK.

This is the gossipper-idiomatic way to achieve the goal of the
original sipp scenario.

The main part of the scenario defines the INVITE call flow:
1. Receives an INVITE.
2. Sends a 200 OK with SDP.
3. Receives an ACK.
4. Pauses.
5. Receives a BYE.
6. Sends a 200 OK for the BYE.

The '_unexp.main' label at the end of the scenario is a special
feature in gossipper. It acts as a catch-all for any message that
is not explicitly handled by a <recv> in the main flow.

When a non-INVITE message (like an OPTIONS request) is received,
the scenario jumps to the '_unexp.main' label. This part of the
scenario sends a generic 200 OK response. The 'jump' action with
the 'to_var' attribute then returns the execution flow to where it
was interrupted, so the scenario continues to wait for the INVITE.
-->
<scenario name="uas-rtp-echo-fixed">
  <recv request="INVITE"/>

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=[pid]PCAPUASTag[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:[service]@[local_ip]:[local_port]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=user1 53655765 2353687637 IN IP[local_ip_type] [public_ip]
c=IN IP[media_ip_type] [public_ip]
m=audio [auto_media_port] RTP/AVP 96 8 0 120 121
a=sendrecv
a=rtpmap:96 opus/48000/2
a=fmtp:96 useinbandfec=1
a=rtpmap:8 PCMA/8000
a=rtpmap:0 PCMU/8000
a=rtpmap:120 telephone-event/48000
a=fmtp:120 0-16
a=rtpmap:121 telephone-event/8000
a=fmtp:121 0-16

]]>
  </send>

  <recv request="ACK" optional="true"/>
  
  <exec rtp_stream="echo"/>

  <recv request="BYE"/>

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

  <!-- Unexpected request handler -->
  <label id="_unexp.main"/>
  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=[pid]DefaultTag[call_number]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0
]]>
  </send>
  <jump variable="_unexp.retaddr" />

</scenario>
