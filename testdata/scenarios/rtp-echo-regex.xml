<?xml version="1.0" encoding="UTF-8"?>
<!--
This scenario acts as a User Agent Server (UAS) that handles
incoming INVITE requests and also responds to any other non-INVITE
SIP messages (like OPTIONS) with a 200 OK.

This version uses the newly implemented 'regexp_match="true"' feature
to allow the initial <recv> to match any SIP request method.
-->
<scenario name="uas-rtp-echo-regex">
  <!-- Use regexp_match="true" to catch any initial SIP request. -->
  <!-- The pattern will match any line starting with a known SIP method. -->
  <recv request="^(INVITE|OPTIONS|BYE|ACK|SUBSCRIBE|NOTIFY|MESSAGE|REFER|UPDATE|PRACK|INFO|PUBLISH|REGISTER)" regexp_match="true">
    <action>
      <!-- Check if the method is INVITE -->
      <ereg regexp="^INVITE" search_in="msg" assign_to="is_invite" />
    </action>
  </recv>

  <!-- Branch based on whether it was an INVITE or not -->
  <nop test="is_invite" next="handle_invite" />

  <!-- Handle non-INVITE messages (e.g., OPTIONS) -->
  <label id="handle_non_invite"/>
  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:];tag=[pid]NonInviteTag[call_number]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>
  <!-- Jump to end of scenario — skip the INVITE path below. -->
  <nop next="done"/>


  <!-- Handle INVITE messages -->
  <label id="handle_invite"/>
  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_Record-Route:]
[last_From:]
[last_To:];tag=[pid]PCAPUASTag[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:[service]@[local_ip]:[local_port]>
Content-Type: application/sdp
Content-Length: [len]

v=0
o=user1 53655765 2353687637 IN IP[local_ip_type] [public_ip]
c=IN IP[media_ip_type] [public_ip]
m=audio [auto_media_port] RTP/AVP 0
a=rtpmap:0 PCMU/8000
a=rtpmap:96 opus/48000/2
a=fmtp:96 useinbandfec=1
a=rtpmap:8 PCMA/8000
a=rtpmap:120 telephone-event/48000
a=fmtp:120 0-16
a=rtpmap:121 telephone-event/8000
a=fmtp:121 0-16
]]>
  </send>

  <recv request="ACK" optional="true"/>

  <exec rtp_stream="echo"/>

  <recv request="BYE"/>

  <send>
    <![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]>
  </send>

  <label id="done"/>

</scenario>
