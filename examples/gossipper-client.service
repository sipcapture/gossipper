# Gossipper SIP client / load generator preset (flat JSON via gossipper server -config).
# Edit /usr/local/gossipper/etc/gossipper-client.json (remote_addr, scenario_name, rates, …). Source sample: examples/gossipper-uac.json.
#
# From source tree:
#   sudo install -m0644 examples/gossipper-client.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gossipper-client
#
# From .deb / .rpm (nfpm): binary at /usr/local/gossipper/bin/gossipper
#   sudo systemctl enable --now gossipper-client

[Unit]
Description=Gossipper client (UAC / load generator)
Documentation=file:/usr/local/gossipper/etc/doc/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/gossipper/bin/gossipper server -config /usr/local/gossipper/etc/gossipper-client.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
